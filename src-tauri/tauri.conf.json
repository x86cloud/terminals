{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "xTerminal",
  "version": "1.1.1",
  "identifier": "com.x86cloud.xterminal",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "xTerminal",
        "width": 1920,
        "height": 1080,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}