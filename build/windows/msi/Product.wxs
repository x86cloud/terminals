<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="xClient"
           Manufacturer="zShiyang"
           Version="$(var.Version)"
           UpgradeCode="d2e46358-6929-4e78-bc48-f6825dfa2d13"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="A newer version of xClient is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="$(var.SourceDir)\build\windows\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="xClient" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="xClient" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable" Guid="a1b2c3d4-e5f6-7890-1234-56789abcdef0">
        <File Id="xClientExe" Source="$(var.SourceDir)\build\bin\xClient.exe" KeyPath="yes">
          <Shortcut Id="DesktopShortcut"
                    Directory="DesktopFolder"
                    Name="xClient"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon"
                    Advertise="yes" />
          <Shortcut Id="StartMenuShortcut"
                    Directory="ApplicationProgramsFolder"
                    Name="xClient"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon"
                    Advertise="yes" />
        </File>
        <RemoveFolder Id="CleanUpStartMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="xClient Application" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>
  </Package>
</Wix>
